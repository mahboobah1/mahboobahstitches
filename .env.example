# Copy to .dev.vars for local Worker development, or add in
# Cloudflare dashboard > Workers & Pages > your project > Settings > Variables.
# NEVER commit real values. Phase 1 needs none of these.

# --- Phase 4: payments (do not set until you have a Paystack account) ---
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=

# --- Phase 2: authentication ---
# SESSION_SECRET=   (long random string)
